# ==============================================================================
# ClassScheduling Application Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env with real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Required)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (find in Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (find in Project Settings > API > Project API keys)
# Note: SUPABASE_PUBLISHABLE_KEY is also accepted as an alias.
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# Supabase Admin / Auth Management (Optional)
# ------------------------------------------------------------------------------
# Service Role Secret Key: ONLY needed for server-side admin user creation.
# Keep this secret and NEVER expose it to the browser.
# SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-here

# ------------------------------------------------------------------------------
# Flask Application Settings (Optional)
# ------------------------------------------------------------------------------
# Secret key used for signing session cookies
SECRET_KEY=replace-with-a-secure-random-string

# Enable Flask debug mode for development (1 = enabled, 0 = disabled)
FLASK_DEBUG=1

# Host and Port configuration
HOST=0.0.0.0
PORT=5000
